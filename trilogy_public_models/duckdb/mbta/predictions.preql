import common;

key prediction_id string; # one predicted stop event (trip x stop x direction)
property prediction_id.predicted_arrival datetime?;
property prediction_id.predicted_departure datetime?;
property prediction_id.arrival_uncertainty_seconds int?;
property prediction_id.departure_uncertainty_seconds int?;
property prediction_id.prediction_stop_sequence int?;
property prediction_id.prediction_status string?; # human override text, e.g. 'Stopped 5 stops away'
property prediction_id.schedule_relationship string?; # ADDED / CANCELLED / SKIPPED / null for scheduled
property prediction_id.prediction_update_type string?;

root datasource prediction_observations (
    id: prediction_id,
    route_id: ?route_id,
    stop_id: ?stop_id,
    trip_id: ?trip_id,
    vehicle_id: ?vehicle_id,
    direction_id: ?direction_id,
    arrival_time: ?predicted_arrival,
    departure_time: ?predicted_departure,
    arrival_uncertainty: ?arrival_uncertainty_seconds,
    departure_uncertainty: ?departure_uncertainty_seconds,
    stop_sequence: ?prediction_stop_sequence,
    status: ?prediction_status,
    schedule_relationship: ?schedule_relationship,
    update_type: ?prediction_update_type,
    mbta_data_updated_through: mbta_data_updated_through,
)
grain (prediction_id)
file `https://storage.googleapis.com/trilogy_public_models/duckdb/mbta/prediction_observations_v1.parquet`;
