# Process ancestry: each process with its parent and the application it belongs
# to. An application is the process at the top of a launch tree below a
# launcher (explorer, services, svchost, init, ...), so its totals include child
# processes with other executable names. Every tree has a root, so system
# processes started directly by the kernel (Memory Compression, Registry, ...)
# are applications of their own. Two copies of one program started separately
# are two applications.
import std.bytes;
import std.date;
import process as process;
import process as parent;
import process as app;

merge process.parent_pid into parent.pid;
merge process.application_pid into app.pid;

auto process_count <- count(process.pid);
auto total_resident_mb <- round(sum(process.resident_bytes) / 1048576.0, 1)::mib; # resident memory in MiB (1,048,576 bytes)
auto total_cpu_seconds <- round(sum(process.cpu_seconds), 1)::second;
