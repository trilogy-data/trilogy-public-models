# Open network connections (sockets with a remote end), and the owning process.
import process as process;

key connection_id string; # pid/protocol/local>remote
properties connection_id (
    protocol string, # tcp or udp
    family string, # ipv4 or ipv6
    local_address string,
    local_port int,
    remote_address string,
    remote_port int,
    state string?, # e.g. ESTABLISHED, TIME_WAIT; closed TIME_WAIT sockets belong to no process (pid 0 on Windows)
);

datasource connections (
    connection_id: connection_id,
    pid: ~?process.pid,
    protocol: protocol,
    family: family,
    local_address: local_address,
    local_port: local_port,
    remote_address: remote_address,
    remote_port: remote_port,
    state: state,
)
grain (connection_id)
file `./ingest/connection.py`;
