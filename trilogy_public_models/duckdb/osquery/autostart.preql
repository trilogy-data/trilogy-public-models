# Programs configured to start automatically: at sign-in (Run keys, Startup
# folders, login items) or at boot (automatic Windows services).

key autostart_id string; # kind/source/name
properties autostart_id (
    kind string, # startup_item or service
    trigger string, # sign_in or boot
    name string,
    path string?, # executable or command line
    source string?, # registry key, startup folder, or service name
    status string?, # enabled/disabled for startup items, RUNNING/STOPPED for services
    username string?, # account it runs as, when reported
    run_once bool, # a RunOnce entry: runs at the next sign-in, then Windows removes it
);

datasource autostarts (
    autostart_id: autostart_id,
    kind: kind,
    trigger: trigger,
    name: name,
    path: path,
    source: source,
    status: status,
    username: username,
    run_once: run_once,
)
grain (autostart_id)
file `./ingest/osquery.py#autostart`;
