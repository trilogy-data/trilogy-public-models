import event;

# The full USGS ComCat catalog, searched live per query. Always filter by
# event_time and/or magnitude: unfiltered, it asks for the whole catalog.
datasource catalog (
    event_id,
    time: event_time,
    updated: updated_at,
    mag: ?magnitude,
    magtype: ?magnitude_type,
    place: ?place,
    title,
    depth: depth_km,
    latitude,
    longitude,
    type: event_type,
    status,
    tsunami,
    alert: ?alert,
    felt: ?felt_reports,
    sig: significance,
    net: network,
    url,
)
grain (event_id)
address usgs_earthquakes.main.historical;
