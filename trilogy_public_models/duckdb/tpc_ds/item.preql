import std.money;

key id int; # Surrogate key uniquely identifying a sellable item.

properties id (
    name string, # Stable item business identifier (TPC-DS I_ITEM_ID — 16-char alphanumeric, not a display name).
    brand_id int?, # Numeric brand identifier.
    brand_name string?, # Brand display name.
    manufacturer_id int?, # Numeric manufacturer identifier.
    category string?, # Top-level product category (e.g. 'Electronics', 'Books').
    current_price numeric::usd?, # Current list/catalog price in USD.
    class string?, # Product class (sub-category within a category).
    desc string?, # Free-form item description.
    color string?, # Primary color of the item.
    manager_id int?, # Identifier of the merchandise manager responsible for the item.
    size string?, # Size descriptor (free-form, e.g. 'medium', 'XL', 'petite').
    units string?, # Unit-of-measure descriptor (e.g. 'Each', 'Ounce', 'Pound').
);

datasource items (
    I_ITEM_SK: id,
    I_ITEM_ID: name,
    I_ITEM_DESC: desc,
    I_BRAND: brand_name,
    I_BRAND_ID: brand_id,
    I_MANUFACT_ID: manufacturer_id,
    I_CATEGORY: category,
    I_CLASS: class,
    I_CURRENT_PRICE: current_price,
    I_COLOR: color,
    I_MANAGER_ID: manager_id,
    I_SIZE: size,
    I_UNITS: units
)
grain (id)
address memory.item;
