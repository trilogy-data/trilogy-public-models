key id int; # Surrogate key uniquely identifying a warehouse.

properties id (
    string_id string, # Stable business identifier for the warehouse (16-char alphanumeric).
    name string, # Warehouse display name.
    square_feet int, # Total floor space of the warehouse in square feet.
);

datasource warehouse (
    w_warehouse_sk: id,
    w_warehouse_id: string_id,
    w_warehouse_name: name,
    w_warehouse_sq_ft: square_feet,
)
grain (id)
address memory.warehouse;
