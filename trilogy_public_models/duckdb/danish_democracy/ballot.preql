import vote as vote;
import actor as actor;

key id int; # Folketinget Stemme identifier
properties id (
    type_id int?,
    updated_at datetime,
    ids_reconciled_at datetime?, # most recent full live-ID scan, naive UTC
    source_updated_at string,
    type_name string?,
);

root datasource ballot (
    id: id,
    vote_id: ~?vote.id,
    actor_id: ~?actor.id,
    type_id: type_id,
    updated_at: updated_at,
    ids_reconciled_at: ids_reconciled_at,
    source_updated_at: source_updated_at,
    type_name: type_name,
)
grain (id)
file `https://storage.googleapis.com/trilogy_public_models/duckdb/danish_democracy/ballot.parquet`;
