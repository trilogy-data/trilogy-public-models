import common;

key id int;
properties id (
    case_id int,
    title string?,
    held_at datetime?,
    type_id int,
    status_id int,
    updated_at datetime,
    ids_reconciled_at datetime?, # most recent full live-ID scan, naive UTC
    source_updated_at string,
    type_name string?,
    status_name string?,
);

root datasource case_step_raw (
    id: id,
    case_id: case_id,
    title: title,
    held_at: held_at,
    type_id: type_id,
    status_id: status_id,
    updated_at: updated_at,
    ids_reconciled_at: ids_reconciled_at,
    source_updated_at: source_updated_at,
    type_name: type_name,
    status_name: status_name,
)
grain (id)
file `ingest/case_step.py`;

datasource case_step (
    id: id,
    case_id: case_id,
    title: title,
    held_at: held_at,
    type_id: type_id,
    status_id: status_id,
    updated_at: updated_at,
    ids_reconciled_at: ids_reconciled_at,
    source_updated_at: source_updated_at,
    type_name: type_name,
    status_name: status_name,
    snapshot_date: snapshot_date,
)
grain (id)
file `https://storage.googleapis.com/trilogy_public_models/duckdb/danish_democracy/case_step.parquet`:`gcs://trilogy_public_models/duckdb/danish_democracy/case_step.parquet`
freshness by snapshot_date;
