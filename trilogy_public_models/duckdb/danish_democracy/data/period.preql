import common;

key id int;
properties id (
    code string?,
    title string?,
    type string?,
    starts_at datetime,
    ends_at datetime,
    updated_at datetime,
    ids_reconciled_at datetime?, # most recent full live-ID scan, naive UTC
    source_updated_at string,
);

root datasource period_raw (
    id: id,
    code: code,
    title: title,
    type: type,
    starts_at: starts_at,
    ends_at: ends_at,
    updated_at: updated_at,
    ids_reconciled_at: ids_reconciled_at,
    source_updated_at: source_updated_at,
)
grain (id)
file `ingest/period.py`;

datasource period (
    id: id,
    code: code,
    title: title,
    type: type,
    starts_at: starts_at,
    ends_at: ends_at,
    updated_at: updated_at,
    ids_reconciled_at: ids_reconciled_at,
    source_updated_at: source_updated_at,
    snapshot_date: snapshot_date,
)
grain (id)
file `https://storage.googleapis.com/trilogy_public_models/duckdb/danish_democracy/period.parquet`:`gcs://trilogy_public_models/duckdb/danish_democracy/period.parquet`
freshness by snapshot_date;
