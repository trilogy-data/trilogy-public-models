import flight;

where flight_date >= '2020-01-01'::date
    and cancelled = 'N'
    and arr_delay is not null
select
    aircraft.model.manufacturer,
    aircraft.model.name,
    avg(arr_delay) as avg_arr_delay,
    count(id) as flight_count,
    avg(distance) as avg_distance,
    avg(flight_time) as avg_flight_time,
    avg(dep_delay) as avg_dep_delay,
    avg(taxi_out) as avg_taxi_out,
    avg(taxi_in) as avg_taxi_in,
    avg(origin.elevation) as avg_origin_elevation,
    avg(destination.elevation) as avg_destination_elevation,
    count(id ? diverted = 'Y') as diverted_flight_count,
    count(id ? origin.cntl_twr = 'Y') as towered_origin_flight_count,
    count(id ? destination.cntl_twr = 'Y') as towered_destination_flight_count
having
    flight_count >= 100
order by
    avg_arr_delay desc
limit 20;