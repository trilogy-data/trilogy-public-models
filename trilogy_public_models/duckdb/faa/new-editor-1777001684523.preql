import flight;
import std.display;

# Average on-time departure rate across airports that are "major"
# by our definition: more than 10,000 non-cancelled flights in 2022.
where flight_date.date >= '2022-01-01'::date
  and flight_date.date < '2023-01-01'::date
  and cancelled = 'N'
select
  origin.full_name,
  count(id) as total_flights,
  --count(id ? dep_delay <= 0) as on_time_departures,
  (count(id ? dep_delay <= 0) / count(id))::percent as on_time_departure_ratio
having total_flights > 100000
order by on_time_departure_ratio desc, total_flights desc
limit 15;