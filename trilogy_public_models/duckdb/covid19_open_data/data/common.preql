# Keys and the freshness anchor shared by every table in the COVID-19 Open Data
# ingest model.
#
# Upstream publishes one CSV per table under
# https://storage.googleapis.com/covid19-open-data/v3/, all keyed on
# location_key, with the daily fact tables additionally keyed on date.

key location_key string; # unique location id; a country code or country_subregion code, eg 'US', 'US_CA', 'FR', 'JP_13'
key date date; # observation date (calendar day)

# The upstream publication time, stamped onto every published tile. Each tile
# declares `freshness by data_updated_through`, so a tile is stale exactly when
# upstream has been republished since the tile was built. Nothing else in the
# dataset can serve as that watermark: the upstream CSVs carry no update column,
# and key-hash watermarks never mark an asset stale on their own.
property <*>.data_updated_through datetime; # when upstream last republished the dataset

root datasource data_update_info (
	data_update_date: data_updated_through,
)
file `ingest_update_date.py`;
