import subnets as subnets;

key col_id string;
property col_id.col_first_ip string;
property col_id.col_last_ip string;

datasource source (
    `ID`:col_id,
    `SUBNET_ID`:subnets.col_id,
    `FIRST_IP`:col_first_ip,
    `LAST_IP`:col_last_ip,
)
grain (col_id)
address `neutron.ipallocationpools`;
