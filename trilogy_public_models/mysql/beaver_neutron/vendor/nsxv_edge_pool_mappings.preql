import ..load_balancing.pools as pools;

property pools.col_id.col_edge_id string;
property pools.col_id.col_edge_pool_id string;

datasource source (
    `POOL_ID`:pools.col_id,
    `EDGE_ID`:col_edge_id,
    `EDGE_POOL_ID`:col_edge_pool_id,
)
grain (pools.col_id)
address `neutron.nsxv_edge_pool_mappings`;
