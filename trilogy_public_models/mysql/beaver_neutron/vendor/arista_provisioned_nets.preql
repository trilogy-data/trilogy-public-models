property col_id.col_tenant_id string;
key col_id string;
property col_id.col_network_id string;
property col_id.col_segmentation_id int;

datasource source (
    `TENANT_ID`:col_tenant_id,
    `ID`:col_id,
    `NETWORK_ID`:col_network_id,
    `SEGMENTATION_ID`:col_segmentation_id,
)
grain (col_id)
address `neutron.arista_provisioned_nets`;
