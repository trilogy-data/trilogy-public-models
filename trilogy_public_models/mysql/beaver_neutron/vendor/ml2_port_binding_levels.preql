import ml2_network_segments as ml2_network_segments;
import ..core.ports as ports;

key col_host string;
key col_level int;
property <ports.col_id, col_host, col_level>.col_driver string;

datasource source (
    `PORT_ID`:ports.col_id,
    `HOST`:col_host,
    `LEVEL`:col_level,
    `DRIVER`:col_driver,
    `SEGMENT_ID`:ml2_network_segments.col_id,
)
grain (ports.col_id, col_host, col_level)
address `neutron.ml2_port_binding_levels`;
