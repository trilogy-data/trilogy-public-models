import ml2_nexus_vxlan_allocations as ml2_nexus_vxlan_allocations;

key col_id string;
property col_id.col_mcast_group string;

datasource source (
    `ID`:col_id,
    `MCAST_GROUP`:col_mcast_group,
    `ASSOCIATED_VNI`:ml2_nexus_vxlan_allocations.col_vxlan_vni,
)
grain (col_id)
address `neutron.ml2_nexus_vxlan_mcast_groups`;
