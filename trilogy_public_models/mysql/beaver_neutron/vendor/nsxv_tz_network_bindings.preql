import ..core.networks as networks;

key col_binding_type string;
key col_phy_uuid string;
key col_vlan_id int;

datasource source (
    `NETWORK_ID`:networks.col_id,
    `BINDING_TYPE`:col_binding_type,
    `PHY_UUID`:col_phy_uuid,
    `VLAN_ID`:col_vlan_id,
)
grain (networks.col_id, col_binding_type, col_phy_uuid, col_vlan_id)
address `neutron.nsxv_tz_network_bindings`;
