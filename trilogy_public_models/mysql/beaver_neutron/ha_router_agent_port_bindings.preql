key col_port_id string;
property col_port_id.col_router_id string;
property col_port_id.col_l3_agent_id string;
property col_port_id.col_state string;

datasource source (
    `PORT_ID`:col_port_id,
    `ROUTER_ID`:col_router_id,
    `L3_AGENT_ID`:col_l3_agent_id,
    `STATE`:col_state,
)
grain (col_port_id)
address `neutron.ha_router_agent_port_bindings`;
