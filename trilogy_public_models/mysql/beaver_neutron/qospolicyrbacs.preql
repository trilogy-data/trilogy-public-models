key col_id string;
property col_id.col_tenant_id string;
property col_id.col_target_tenant string;
property col_id.col_action string;
property col_id.col_object_id string;

datasource source (
    `ID`:col_id,
    `TENANT_ID`:col_tenant_id,
    `TARGET_TENANT`:col_target_tenant,
    `ACTION`:col_action,
    `OBJECT_ID`:col_object_id,
)
grain (col_id)
address `neutron.qospolicyrbacs`;
