key col_id string;
key col_network_gateway_id string;
key col_interface_name string;

datasource source (
    `ID`:col_id,
    `NETWORK_GATEWAY_ID`:col_network_gateway_id,
    `INTERFACE_NAME`:col_interface_name,
)
grain (col_id, col_network_gateway_id, col_interface_name)
address `neutron.networkgatewaydevicereferences`;
