property col_id.col_tenant_id string;
key col_id string;
property col_id.col_name string;
property col_id.col_description string;
property col_id.col_vip_port_id string;
property col_id.col_vip_subnet_id string;
property col_id.col_vip_address string;
property col_id.col_admin_state_up int;
property col_id.col_provisioning_status string;
property col_id.col_operating_status string;
property col_id.col_flavor_id string;

datasource source (
    `TENANT_ID`:col_tenant_id,
    `ID`:col_id,
    `NAME`:col_name,
    `DESCRIPTION`:col_description,
    `VIP_PORT_ID`:col_vip_port_id,
    `VIP_SUBNET_ID`:col_vip_subnet_id,
    `VIP_ADDRESS`:col_vip_address,
    `ADMIN_STATE_UP`:col_admin_state_up,
    `PROVISIONING_STATUS`:col_provisioning_status,
    `OPERATING_STATUS`:col_operating_status,
    `FLAVOR_ID`:col_flavor_id,
)
grain (col_id)
address `neutron.lbaas_loadbalancers`;
