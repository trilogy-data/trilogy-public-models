import networkgateways as networkgateways;

key col_id string;
key col_interface_name string;

datasource source (
    `ID`:col_id,
    `NETWORK_GATEWAY_ID`:networkgateways.col_id,
    `INTERFACE_NAME`:col_interface_name,
)
grain (col_id, networkgateways.col_id, col_interface_name)
address `neutron.networkgatewaydevicereferences`;
