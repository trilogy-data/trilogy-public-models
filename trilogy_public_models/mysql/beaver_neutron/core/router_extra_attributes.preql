import routers as routers;

property routers.col_id.col_distributed int;
property routers.col_id.col_service_router int;
property routers.col_id.col_ha int;
property routers.col_id.col_ha_vr_id int;
property routers.col_id.col_availability_zone_hints string;

datasource source (
    `ROUTER_ID`:routers.col_id,
    `DISTRIBUTED`:col_distributed,
    `SERVICE_ROUTER`:col_service_router,
    `HA`:col_ha,
    `HA_VR_ID`:col_ha_vr_id,
    `AVAILABILITY_ZONE_HINTS`:col_availability_zone_hints,
)
grain (routers.col_id)
address `neutron.router_extra_attributes`;
