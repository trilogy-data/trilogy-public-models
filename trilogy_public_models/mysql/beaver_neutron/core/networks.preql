import ..other.standardattributes as standardattributes;

property col_id.col_tenant_id string;
key col_id string;
property col_id.col_name string;
property col_id.col_status string;
property col_id.col_admin_state_up int;
property col_id.col_mtu int;
property col_id.col_vlan_transparent int;
property col_id.col_availability_zone_hints string;

datasource source (
    `TENANT_ID`:col_tenant_id,
    `ID`:col_id,
    `NAME`:col_name,
    `STATUS`:col_status,
    `ADMIN_STATE_UP`:col_admin_state_up,
    `MTU`:col_mtu,
    `VLAN_TRANSPARENT`:col_vlan_transparent,
    `STANDARD_ATTR_ID`:standardattributes.col_id,
    `AVAILABILITY_ZONE_HINTS`:col_availability_zone_hints,
)
grain (col_id)
address `neutron.networks`;
