import ipamsubnets as ipamsubnets;

key col_id string;
property col_id.col_first_ip string;
property col_id.col_last_ip string;

datasource source (
    `ID`:col_id,
    `IPAM_SUBNET_ID`:ipamsubnets.col_id,
    `FIRST_IP`:col_first_ip,
    `LAST_IP`:col_last_ip,
)
grain (col_id)
address `neutron.ipamallocationpools`;
