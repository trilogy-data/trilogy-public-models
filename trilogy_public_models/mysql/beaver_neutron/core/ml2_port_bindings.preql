# Primary ML2 port-binding facts, including HOST and VIF_TYPE. Use this for host/VIF questions; PORTBINDINGPORTS is a legacy host-only table.

import ports as ports;

property ports.col_id.col_host string;
property ports.col_id.col_vif_type string;
property ports.col_id.col_vnic_type string;
property ports.col_id.col_vif_details string;
property ports.col_id.col_profile string;

datasource source (
    `PORT_ID`:ports.col_id,
    `HOST`:ports.col_host,
    `VIF_TYPE`:ports.col_vif_type,
    `VNIC_TYPE`:ports.col_vnic_type,
    `VIF_DETAILS`:ports.col_vif_details,
    `PROFILE`:ports.col_profile,
)
grain (ports.col_id)
address `neutron.ml2_port_bindings`;
