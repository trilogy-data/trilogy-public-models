# Currently available address ranges within an IP allocation pool.

import ipallocationpools as ipallocationpools;

key col_first_ip string;
key col_last_ip string;

datasource source (
    `ALLOCATION_POOL_ID`:ipallocationpools.col_id,
    `FIRST_IP`:col_first_ip,
    `LAST_IP`:col_last_ip,
)
grain (ipallocationpools.col_id, col_first_ip, col_last_ip)
address `neutron.ipavailabilityranges`;
