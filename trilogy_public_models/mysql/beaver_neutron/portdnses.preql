key col_port_id string;
property col_port_id.col_current_dns_name string;
property col_port_id.col_current_dns_domain string;
property col_port_id.col_previous_dns_name string;
property col_port_id.col_previous_dns_domain string;

datasource source (
    `PORT_ID`:col_port_id,
    `CURRENT_DNS_NAME`:col_current_dns_name,
    `CURRENT_DNS_DOMAIN`:col_current_dns_domain,
    `PREVIOUS_DNS_NAME`:col_previous_dns_name,
    `PREVIOUS_DNS_DOMAIN`:col_previous_dns_domain,
)
grain (col_port_id)
address `neutron.portdnses`;
