key col_id int;
property col_id.col_source string;
property col_id.col_destination string;
property col_id.col_action string;
property col_id.col_router_id string;

datasource source (
    `ID`:col_id,
    `SOURCE`:col_source,
    `DESTINATION`:col_destination,
    `ACTION`:col_action,
    `ROUTER_ID`:col_router_id,
)
grain (col_id)
address `neutron.routerrules`;
