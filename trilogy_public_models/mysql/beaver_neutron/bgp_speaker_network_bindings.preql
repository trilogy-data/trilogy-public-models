import bgp_speakers as bgp_speakers;
import networks as networks;

key col_ip_version int;

datasource source (
    `BGP_SPEAKER_ID`:bgp_speakers.col_id,
    `NETWORK_ID`:networks.col_id,
    `IP_VERSION`:col_ip_version,
)
grain (networks.col_id, bgp_speakers.col_id, col_ip_version)
address `neutron.bgp_speaker_network_bindings`;
