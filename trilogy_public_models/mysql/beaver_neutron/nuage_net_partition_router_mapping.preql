key col_net_partition_id string;
key col_router_id string;
property <col_net_partition_id, col_router_id>.col_nuage_router_id string;
property <col_net_partition_id, col_router_id>.col_nuage_rtr_rd string;
property <col_net_partition_id, col_router_id>.col_nuage_rtr_rt string;

datasource source (
    `NET_PARTITION_ID`:col_net_partition_id,
    `ROUTER_ID`:col_router_id,
    `NUAGE_ROUTER_ID`:col_nuage_router_id,
    `NUAGE_RTR_RD`:col_nuage_rtr_rd,
    `NUAGE_RTR_RT`:col_nuage_rtr_rt,
)
grain (col_net_partition_id, col_router_id)
address `neutron.nuage_net_partition_router_mapping`;
