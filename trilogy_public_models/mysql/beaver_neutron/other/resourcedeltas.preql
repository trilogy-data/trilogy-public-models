import ..system.reservations as reservations;

key col_resource string;
property <col_resource, reservations.col_id>.col_amount int;

datasource source (
    `RESOURCE`:col_resource,
    `RESERVATION_ID`:reservations.col_id,
    `AMOUNT`:col_amount,
)
grain (col_resource, reservations.col_id)
address `neutron.resourcedeltas`;
