key col_id string;
property col_id.col_name string;
property col_id.col_description string;
property col_id.col_enabled int;
property col_id.col_service_type string;

datasource source (
    `ID`:col_id,
    `NAME`:col_name,
    `DESCRIPTION`:col_description,
    `ENABLED`:col_enabled,
    `SERVICE_TYPE`:col_service_type,
)
grain (col_id)
address `neutron.flavors`;
