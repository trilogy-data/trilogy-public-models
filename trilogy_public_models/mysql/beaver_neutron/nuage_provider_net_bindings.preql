key col_network_id string;
property col_network_id.col_network_type string;
property col_network_id.col_physical_network string;
property col_network_id.col_vlan_id int;

datasource source (
    `NETWORK_ID`:col_network_id,
    `NETWORK_TYPE`:col_network_type,
    `PHYSICAL_NETWORK`:col_physical_network,
    `VLAN_ID`:col_vlan_id,
)
grain (col_network_id)
address `neutron.nuage_provider_net_bindings`;
