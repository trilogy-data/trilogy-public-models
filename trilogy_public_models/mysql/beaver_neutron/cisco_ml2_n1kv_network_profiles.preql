key col_id string;
property col_id.col_name string;
property col_id.col_segment_type string;
property col_id.col_segment_range string;
property col_id.col_multicast_ip_index int;
property col_id.col_multicast_ip_range string;
property col_id.col_sub_type string;
property col_id.col_physical_network string;

datasource source (
    `ID`:col_id,
    `NAME`:col_name,
    `SEGMENT_TYPE`:col_segment_type,
    `SEGMENT_RANGE`:col_segment_range,
    `MULTICAST_IP_INDEX`:col_multicast_ip_index,
    `MULTICAST_IP_RANGE`:col_multicast_ip_range,
    `SUB_TYPE`:col_sub_type,
    `PHYSICAL_NETWORK`:col_physical_network,
)
grain (col_id)
address `neutron.cisco_ml2_n1kv_network_profiles`;
