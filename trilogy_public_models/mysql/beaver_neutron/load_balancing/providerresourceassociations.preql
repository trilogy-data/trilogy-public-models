# Provider assignments for polymorphic resources. The weak lbaas_loadbalancers role exists only where RESOURCE_ID is a load balancer.

import lbaas_loadbalancers as lbaas_loadbalancers;

key col_provider_name string;

datasource source (
    `PROVIDER_NAME`:col_provider_name,
    `RESOURCE_ID`:~lbaas_loadbalancers.col_id,
)
grain (col_provider_name, lbaas_loadbalancers.col_id)
address `neutron.providerresourceassociations`;
