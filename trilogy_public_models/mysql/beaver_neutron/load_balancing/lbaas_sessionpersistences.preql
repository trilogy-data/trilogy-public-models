import lbaas_pools as lbaas_pools;

property lbaas_pools.col_id.col_type string;
property lbaas_pools.col_id.col_cookie_name string;

datasource source (
    `POOL_ID`:lbaas_pools.col_id,
    `TYPE`:lbaas_pools.col_type,
    `COOKIE_NAME`:lbaas_pools.col_cookie_name,
)
grain (lbaas_pools.col_id)
address `neutron.lbaas_sessionpersistences`;
