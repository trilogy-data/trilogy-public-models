import ports as ports;

key col_id string;
property col_id.col_opt_name string;
property col_id.col_opt_value string;
property col_id.col_ip_version int;

datasource source (
    `ID`:col_id,
    `PORT_ID`:ports.col_id,
    `OPT_NAME`:col_opt_name,
    `OPT_VALUE`:col_opt_value,
    `IP_VERSION`:col_ip_version,
)
grain (col_id)
address `neutron.extradhcpopts`;
