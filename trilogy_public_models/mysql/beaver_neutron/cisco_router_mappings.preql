import cisco_hosting_devices as cisco_hosting_devices;
import routers as routers;

property routers.col_id.col_auto_schedule int;

datasource source (
    `ROUTER_ID`:routers.col_id,
    `AUTO_SCHEDULE`:col_auto_schedule,
    `HOSTING_DEVICE_ID`:cisco_hosting_devices.col_id,
)
grain (routers.col_id)
address `neutron.cisco_router_mappings`;
