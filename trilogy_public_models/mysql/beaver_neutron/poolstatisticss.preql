key col_pool_id string;
property col_pool_id.col_bytes_in int;
property col_pool_id.col_bytes_out int;
property col_pool_id.col_active_connections int;
property col_pool_id.col_total_connections int;

datasource source (
    `POOL_ID`:col_pool_id,
    `BYTES_IN`:col_bytes_in,
    `BYTES_OUT`:col_bytes_out,
    `ACTIVE_CONNECTIONS`:col_active_connections,
    `TOTAL_CONNECTIONS`:col_total_connections,
)
grain (col_pool_id)
address `neutron.poolstatisticss`;
