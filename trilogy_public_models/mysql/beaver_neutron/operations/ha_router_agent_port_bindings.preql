import agents as agents;
import ..core.ports as ports;
import ..core.routers as routers;

property ports.col_id.col_state string;

datasource source (
    `PORT_ID`:ports.col_id,
    `ROUTER_ID`:routers.col_id,
    `L3_AGENT_ID`:agents.col_id,
    `STATE`:ports.col_state,
)
grain (ports.col_id)
address `neutron.ha_router_agent_port_bindings`;
