key col_floatingip_id string;
property col_floatingip_id.col_dns_name string;
property col_floatingip_id.col_dns_domain string;
property col_floatingip_id.col_published_dns_name string;
property col_floatingip_id.col_published_dns_domain string;

datasource source (
    `FLOATINGIP_ID`:col_floatingip_id,
    `DNS_NAME`:col_dns_name,
    `DNS_DOMAIN`:col_dns_domain,
    `PUBLISHED_DNS_NAME`:col_published_dns_name,
    `PUBLISHED_DNS_DOMAIN`:col_published_dns_domain,
)
grain (col_floatingip_id)
address `neutron.floatingipdnses`;
