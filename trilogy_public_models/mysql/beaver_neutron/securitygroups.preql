import standardattributes as standardattributes;

property col_id.col_tenant_id string;
key col_id string;
property col_id.col_name string;

datasource source (
    `TENANT_ID`:col_tenant_id,
    `ID`:col_id,
    `NAME`:col_name,
    `STANDARD_ATTR_ID`:standardattributes.col_id,
)
grain (col_id)
address `neutron.securitygroups`;
