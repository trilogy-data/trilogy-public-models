key col_port_id string;
property col_port_id.col_host string;
property col_port_id.col_vif_type string;
property col_port_id.col_vnic_type string;
property col_port_id.col_vif_details string;
property col_port_id.col_profile string;

datasource source (
    `PORT_ID`:col_port_id,
    `HOST`:col_host,
    `VIF_TYPE`:col_vif_type,
    `VNIC_TYPE`:col_vnic_type,
    `VIF_DETAILS`:col_vif_details,
    `PROFILE`:col_profile,
)
grain (col_port_id)
address `neutron.ml2_port_bindings`;
