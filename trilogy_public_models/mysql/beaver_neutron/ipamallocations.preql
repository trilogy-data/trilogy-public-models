key col_ip_address string;
property <col_ip_address, col_ipam_subnet_id>.col_status string;
key col_ipam_subnet_id string;

datasource source (
    `IP_ADDRESS`:col_ip_address,
    `STATUS`:col_status,
    `IPAM_SUBNET_ID`:col_ipam_subnet_id,
)
grain (col_ip_address, col_ipam_subnet_id)
address `neutron.ipamallocations`;
