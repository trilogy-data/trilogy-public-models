property col_id.col_tenant_id string;
key col_id string;
property col_id.col_name string;
property col_id.col_description string;
property col_id.col_listener_id string;
property col_id.col_action string;
property col_id.col_redirect_pool_id string;
property col_id.col_redirect_url string;
property col_id.col_position int;
property col_id.col_provisioning_status string;
property col_id.col_admin_state_up int;

datasource source (
    `TENANT_ID`:col_tenant_id,
    `ID`:col_id,
    `NAME`:col_name,
    `DESCRIPTION`:col_description,
    `LISTENER_ID`:col_listener_id,
    `ACTION`:col_action,
    `REDIRECT_POOL_ID`:col_redirect_pool_id,
    `REDIRECT_URL`:col_redirect_url,
    `POSITION`:col_position,
    `PROVISIONING_STATUS`:col_provisioning_status,
    `ADMIN_STATE_UP`:col_admin_state_up,
)
grain (col_id)
address `neutron.lbaas_l7policies`;
