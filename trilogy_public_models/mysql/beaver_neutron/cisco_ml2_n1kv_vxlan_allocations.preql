import cisco_ml2_n1kv_network_profiles as cisco_ml2_n1kv_network_profiles;

key col_vxlan_id int;
property col_vxlan_id.col_allocated int;

datasource source (
    `VXLAN_ID`:col_vxlan_id,
    `ALLOCATED`:col_allocated,
    `NETWORK_PROFILE_ID`:cisco_ml2_n1kv_network_profiles.col_id,
)
grain (col_vxlan_id)
address `neutron.cisco_ml2_n1kv_vxlan_allocations`;
