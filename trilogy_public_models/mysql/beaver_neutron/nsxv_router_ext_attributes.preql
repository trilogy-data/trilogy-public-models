import routers as routers;

property routers.col_id.col_distributed int;
property routers.col_id.col_router_type string;
property routers.col_id.col_service_router int;

datasource source (
    `ROUTER_ID`:routers.col_id,
    `DISTRIBUTED`:col_distributed,
    `ROUTER_TYPE`:col_router_type,
    `SERVICE_ROUTER`:col_service_router,
)
grain (routers.col_id)
address `neutron.nsxv_router_ext_attributes`;
