key col_listener_id string;
key col_tls_container_id string;
property <col_listener_id, col_tls_container_id>.col_position int;

datasource source (
    `LISTENER_ID`:col_listener_id,
    `TLS_CONTAINER_ID`:col_tls_container_id,
    `POSITION`:col_position,
)
grain (col_listener_id, col_tls_container_id)
address `neutron.lbaas_sni`;
