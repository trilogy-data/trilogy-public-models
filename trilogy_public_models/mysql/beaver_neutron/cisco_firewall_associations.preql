    `PORT_ID`:col_port_id,
    `DIRECTION`:col_direction,
    `ACL_ID`:col_acl_id,
    `ROUTER_ID`:col_router_id,
)
grain (col_fw_id)
address `neutron.cisco_firewall_associations`;
