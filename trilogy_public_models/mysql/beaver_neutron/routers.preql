property col_id.col_tenant_id string;
key col_id string;
property col_id.col_name string;
property col_id.col_status string;
property col_id.col_admin_state_up int;
property col_id.col_gw_port_id string;
property col_id.col_enable_snat int;
property col_id.col_standard_attr_id int;

datasource source (
    `TENANT_ID`:col_tenant_id,
    `ID`:col_id,
    `NAME`:col_name,
    `STATUS`:col_status,
    `ADMIN_STATE_UP`:col_admin_state_up,
    `GW_PORT_ID`:col_gw_port_id,
    `ENABLE_SNAT`:col_enable_snat,
    `STANDARD_ATTR_ID`:col_standard_attr_id,
)
grain (col_id)
address `neutron.routers`;
