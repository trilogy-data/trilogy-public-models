key col_allocation_pool_id string;
key col_first_ip string;
key col_last_ip string;

datasource source (
    `ALLOCATION_POOL_ID`:col_allocation_pool_id,
    `FIRST_IP`:col_first_ip,
    `LAST_IP`:col_last_ip,
)
grain (col_allocation_pool_id, col_first_ip, col_last_ip)
address `neutron.ipavailabilityranges`;
