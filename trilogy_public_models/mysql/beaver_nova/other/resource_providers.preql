key col_id int;
property col_id.col_uuid string;
property col_id.col_name string;
property col_id.col_generation int;
property col_id.col_can_host int;

datasource source (
    `ID`:col_id,
    `UUID`:col_uuid,
    `NAME`:col_name,
    `GENERATION`:col_generation,
    `CAN_HOST`:col_can_host,
)
grain (col_id)
address `nova.resource_providers`;
