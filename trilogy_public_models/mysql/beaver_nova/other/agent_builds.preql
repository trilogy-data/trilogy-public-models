property col_id.col_created_at datetime;
property col_id.col_updated_at datetime;
property col_id.col_deleted_at datetime;
key col_id int;
property col_id.col_hypervisor string;
property col_id.col_os string;
property col_id.col_architecture string;
property col_id.col_version string;
property col_id.col_url string;
property col_id.col_md5hash string;
property col_id.col_deleted int;

datasource source (
    `CREATED_AT`:col_created_at,
    `UPDATED_AT`:col_updated_at,
    `DELETED_AT`:col_deleted_at,
    `ID`:col_id,
    `HYPERVISOR`:col_hypervisor,
    `OS`:col_os,
    `ARCHITECTURE`:col_architecture,
    `VERSION`:col_version,
    `URL`:col_url,
    `MD5HASH`:col_md5hash,
    `DELETED`:col_deleted,
)
grain (col_id)
address `nova.agent_builds`;
