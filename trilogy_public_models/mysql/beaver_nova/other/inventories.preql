key col_id int;
property col_id.col_resource_provider_id int;
property col_id.col_resource_class_id int;
property col_id.col_total int;
property col_id.col_reserved int;
property col_id.col_min_unit int;
property col_id.col_max_unit int;
property col_id.col_step_size int;
property col_id.col_allocation_ratio float;

datasource source (
    `ID`:col_id,
    `RESOURCE_PROVIDER_ID`:col_resource_provider_id,
    `RESOURCE_CLASS_ID`:col_resource_class_id,
    `TOTAL`:col_total,
    `RESERVED`:col_reserved,
    `MIN_UNIT`:col_min_unit,
    `MAX_UNIT`:col_max_unit,
    `STEP_SIZE`:col_step_size,
    `ALLOCATION_RATIO`:col_allocation_ratio,
)
grain (col_id)
address `nova.inventories`;
