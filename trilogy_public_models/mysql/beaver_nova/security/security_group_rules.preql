import security_groups as col_group_id_security_groups;
import security_groups as col_parent_group_id_security_groups;

property col_id.col_created_at datetime;
property col_id.col_updated_at datetime;
property col_id.col_deleted_at datetime;
key col_id int;
property col_id.col_protocol string;
property col_id.col_from_port int;
property col_id.col_to_port int;
property col_id.col_cidr string;
property col_id.col_deleted int;

datasource source (
    `CREATED_AT`:col_created_at,
    `UPDATED_AT`:col_updated_at,
    `DELETED_AT`:col_deleted_at,
    `ID`:col_id,
    `PARENT_GROUP_ID`:col_parent_group_id_security_groups.col_id,
    `PROTOCOL`:col_protocol,
    `FROM_PORT`:col_from_port,
    `TO_PORT`:col_to_port,
    `CIDR`:col_cidr,
    `GROUP_ID`:col_group_id_security_groups.col_id,
    `DELETED`:col_deleted,
)
grain (col_id)
address `nova.security_group_rules`;
