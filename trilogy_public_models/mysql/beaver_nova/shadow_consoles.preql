property col_id.col_created_at datetime;
property col_id.col_updated_at datetime;
property col_id.col_deleted_at datetime;
key col_id int;
property col_id.col_instance_name string;
property col_id.col_password string;
property col_id.col_port int;
property col_id.col_pool_id int;
property col_id.col_instance_uuid string;
property col_id.col_deleted int;

datasource source (
    `CREATED_AT`:col_created_at,
    `UPDATED_AT`:col_updated_at,
    `DELETED_AT`:col_deleted_at,
    `ID`:col_id,
    `INSTANCE_NAME`:col_instance_name,
    `PASSWORD`:col_password,
    `PORT`:col_port,
    `POOL_ID`:col_pool_id,
    `INSTANCE_UUID`:col_instance_uuid,
    `DELETED`:col_deleted,
)
grain (col_id)
address `nova.shadow_consoles`;
