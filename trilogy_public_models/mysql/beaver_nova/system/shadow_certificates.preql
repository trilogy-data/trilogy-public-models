property col_id.col_created_at datetime;
property col_id.col_updated_at datetime;
property col_id.col_deleted_at datetime;
key col_id int;
property col_id.col_user_id string;
property col_id.col_project_id string;
property col_id.col_file_name string;
property col_id.col_deleted int;

datasource source (
    `CREATED_AT`:col_created_at,
    `UPDATED_AT`:col_updated_at,
    `DELETED_AT`:col_deleted_at,
    `ID`:col_id,
    `USER_ID`:col_user_id,
    `PROJECT_ID`:col_project_id,
    `FILE_NAME`:col_file_name,
    `DELETED`:col_deleted,
)
grain (col_id)
address `nova.shadow_certificates`;
