import aggregates as aggregates;

property col_id.col_created_at datetime;
property col_id.col_updated_at datetime;
property col_id.col_deleted_at datetime;
key col_id int;
property col_id.col_key string;
property col_id.col_value string;
property col_id.col_deleted int;

datasource source (
    `CREATED_AT`:col_created_at,
    `UPDATED_AT`:col_updated_at,
    `DELETED_AT`:col_deleted_at,
    `ID`:col_id,
    `AGGREGATE_ID`:aggregates.col_id,
    `KEY`:col_key,
    `VALUE`:col_value,
    `DELETED`:col_deleted,
)
grain (col_id)
address `nova.aggregate_metadata`;
