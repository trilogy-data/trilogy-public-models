key col_id int;
property col_id.col_resource_provider_id int;
property col_id.col_consumer_id string;
property col_id.col_resource_class_id int;
property col_id.col_used int;

datasource source (
    `ID`:col_id,
    `RESOURCE_PROVIDER_ID`:col_resource_provider_id,
    `CONSUMER_ID`:col_consumer_id,
    `RESOURCE_CLASS_ID`:col_resource_class_id,
    `USED`:col_used,
)
grain (col_id)
address `nova.allocations`;
