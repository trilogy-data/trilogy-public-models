grain (col_fclt_room_key, col_building_room, fclt_building.col_fclt_building_key, col_floor, fclt_floor.col_fclt_floor_key, col_room, col_space_id, fclt_major_use.col_fclt_major_use_key, col_major_use_desc, col_fclt_use_key, col_use_desc, col_fclt_minor_use_key, col_minor_use_desc, fclt_org_dlc_key.col_fclt_organization_key, col_organization_name, col_fclt_minor_organization_key, col_minor_organization, col_area, col_room_full_name, col_dept_code, col_access_level, col_latitude_wgs, col_longitude_wgs, col_northing_spcs, col_easting_spcs, col_warehouse_load_date)
