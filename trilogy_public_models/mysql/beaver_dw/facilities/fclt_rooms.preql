key col_latitude_wgs int;
key col_longitude_wgs int;
key col_northing_spcs int;
key col_easting_spcs int;
key col_warehouse_load_date date;

datasource source (
    `FCLT_ROOM_KEY`:col_fclt_room_key,
    `BUILDING_ROOM`:col_building_room,
    `FCLT_BUILDING_KEY`:~fclt_building.col_fclt_building_key,
