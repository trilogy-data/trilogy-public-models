    `FCLT_FLOOR_KEY`:~fclt_floor.col_fclt_floor_key,
    `ROOM`:col_room,
    `SPACE_ID`:col_space_id,
    `FCLT_MAJOR_USE_KEY`:~fclt_major_use.col_fclt_major_use_key,
    `MAJOR_USE_DESC`:col_major_use_desc,
    `FCLT_USE_KEY`:col_fclt_use_key,
    `USE_DESC`:col_use_desc,
    `FCLT_MINOR_USE_KEY`:col_fclt_minor_use_key,
    `MINOR_USE_DESC`:col_minor_use_desc,
    `FCLT_ORGANIZATION_KEY`:~fclt_org_dlc_key.col_fclt_organization_key,
    `ORGANIZATION_NAME`:col_organization_name,
