    `DESCRIPTION`:col_description,
    `ASSIGNABLE`:col_assignable,
    `WAREHOUSE_LOAD_DATE`:col_warehouse_load_date,
)
grain (col_fclt_major_use_hist_key, col_fiscal_period, col_fclt_major_use_key, col_major_use, col_description, col_assignable, col_warehouse_load_date)
address `dw.FCLT_MAJOR_USE_HIST`;
