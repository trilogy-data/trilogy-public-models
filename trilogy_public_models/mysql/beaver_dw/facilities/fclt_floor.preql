import fclt_building as fclt_building;

key col_fclt_floor_key string;
key col_floor string;
key col_ext_gross_area int;
key col_assignable_area int;
key col_non_assignable_area int;
key col_floor_sort_sequence string;
key col_level_id string;
key col_building_wings_id string;
key col_access_level string;
key col_warehouse_load_date date;

datasource source (
    `FCLT_FLOOR_KEY`:col_fclt_floor_key,
    `FCLT_BUILDING_KEY`:~fclt_building.col_fclt_building_key,
    `FLOOR`:col_floor,
    `EXT_GROSS_AREA`:col_ext_gross_area,
    `ASSIGNABLE_AREA`:col_assignable_area,
    `NON_ASSIGNABLE_AREA`:col_non_assignable_area,
    `FLOOR_SORT_SEQUENCE`:col_floor_sort_sequence,
    `LEVEL_ID`:col_level_id,
    `BUILDING_WINGS_ID`:col_building_wings_id,
    `ACCESS_LEVEL`:col_access_level,
    `WAREHOUSE_LOAD_DATE`:col_warehouse_load_date,
)
grain (col_fclt_floor_key, fclt_building.col_fclt_building_key, col_floor, col_ext_gross_area, col_assignable_area, col_non_assignable_area, col_floor_sort_sequence, col_level_id, col_building_wings_id, col_access_level, col_warehouse_load_date)
address `dw.FCLT_FLOOR`;
