    `TERM_CODE`:col_term_code,
    `SUBJECT_ID`:col_subject_id,
    `WAREHOUSE_LOAD_DATE`:col_warehouse_load_date,
)
grain (col_library_course_instructor_key, col_library_reserve_catalog_key, col_library_subject_offered_key, col_library_material_status_key, col_term_code, col_subject_id, col_warehouse_load_date)
