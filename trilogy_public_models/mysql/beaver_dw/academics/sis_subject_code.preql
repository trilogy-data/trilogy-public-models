key col_course_number string;
key col_subject_code string;
key col_subject_code_desc string;
key col_department_code string;
key col_department_name string;
key col_school_code string;
key col_school_name string;
key col_warehouse_load_date date;

datasource source (
    `COURSE_NUMBER`:col_course_number,
    `SUBJECT_CODE`:col_subject_code,
    `SUBJECT_CODE_DESC`:col_subject_code_desc,
    `DEPARTMENT_CODE`:col_department_code,
    `DEPARTMENT_NAME`:col_department_name,
    `SCHOOL_CODE`:col_school_code,
    `SCHOOL_NAME`:col_school_name,
    `WAREHOUSE_LOAD_DATE`:col_warehouse_load_date,
)
grain (col_course_number, col_subject_code, col_subject_code_desc, col_department_code, col_department_name, col_school_code, col_school_name, col_warehouse_load_date)
address `dw.SIS_SUBJECT_CODE`;
