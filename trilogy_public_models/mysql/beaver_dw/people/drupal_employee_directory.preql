key col_mit_id string;
key col_last_name string;
key col_first_name string;
key col_middle_name string;
key col_full_name string;
key col_employee_group string;
key col_employee_type string;
key col_has_addl_appointment string;
key col_has_dual_appointment string;
key col_office_location string;
key col_office_phone string;
key col_hr_org_unit_id string;
key col_hr_org_unit_title string;
key col_directory_title string;
key col_primary_title string;
key col_email_address string;
key col_personal_url string;
key col_warehouse_load_date date;

datasource source (
    `MIT_ID`:col_mit_id,
    `LAST_NAME`:col_last_name,
    `FIRST_NAME`:col_first_name,
    `MIDDLE_NAME`:col_middle_name,
    `FULL_NAME`:col_full_name,
    `EMPLOYEE_GROUP`:col_employee_group,
    `EMPLOYEE_TYPE`:col_employee_type,
    `HAS_ADDL_APPOINTMENT`:col_has_addl_appointment,
    `HAS_DUAL_APPOINTMENT`:col_has_dual_appointment,
    `OFFICE_LOCATION`:col_office_location,
    `OFFICE_PHONE`:col_office_phone,
    `HR_ORG_UNIT_ID`:col_hr_org_unit_id,
    `HR_ORG_UNIT_TITLE`:col_hr_org_unit_title,
    `DIRECTORY_TITLE`:col_directory_title,
    `PRIMARY_TITLE`:col_primary_title,
    `EMAIL_ADDRESS`:col_email_address,
    `PERSONAL_URL`:col_personal_url,
    `WAREHOUSE_LOAD_DATE`:col_warehouse_load_date,
)
grain (col_mit_id, col_last_name, col_first_name, col_middle_name, col_full_name, col_employee_group, col_employee_type, col_has_addl_appointment, col_has_dual_appointment, col_office_location, col_office_phone, col_hr_org_unit_id, col_hr_org_unit_title, col_directory_title, col_primary_title, col_email_address, col_personal_url, col_warehouse_load_date)
