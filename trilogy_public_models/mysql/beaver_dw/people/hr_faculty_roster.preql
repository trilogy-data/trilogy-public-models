    `ENDOWED_CHAIR`:col_endowed_chair,
    `EMERITUS_STATUS`:col_emeritus_status,
    `WAREHOUSE_LOAD_DATE`:col_warehouse_load_date,
)
grain (col_mit_id, col_last_name, col_first_name, col_middle_name, col_terminal_degree, col_appointment_type, col_job_title, col_hr_org_unit_title, col_position_title, col_admin_org_unit_title, col_admin_position_title, col_admin_job_title, col_directory_org_unit_title, col_endowed_chair, col_emeritus_status, col_warehouse_load_date)
address `dw.HR_FACULTY_ROSTER`;
