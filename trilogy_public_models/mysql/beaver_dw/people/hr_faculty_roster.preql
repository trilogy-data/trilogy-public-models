key col_mit_id string;
key col_last_name string;
key col_first_name string;
key col_middle_name string;
key col_terminal_degree string;
key col_appointment_type string;
key col_job_title string;
key col_hr_org_unit_title string;
key col_position_title string;
key col_admin_org_unit_title string;
key col_admin_position_title string;
key col_admin_job_title string;
key col_directory_org_unit_title string;
key col_endowed_chair string;
key col_emeritus_status string;
key col_warehouse_load_date date;

datasource source (
    `MIT_ID`:col_mit_id,
    `LAST_NAME`:col_last_name,
    `FIRST_NAME`:col_first_name,
    `MIDDLE_NAME`:col_middle_name,
    `TERMINAL_DEGREE`:col_terminal_degree,
    `APPOINTMENT_TYPE`:col_appointment_type,
    `JOB_TITLE`:col_job_title,
    `HR_ORG_UNIT_TITLE`:col_hr_org_unit_title,
    `POSITION_TITLE`:col_position_title,
    `ADMIN_ORG_UNIT_TITLE`:col_admin_org_unit_title,
