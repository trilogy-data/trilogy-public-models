import passenger;
import wealth as wealth;

MERGE wealth.last_name into ~last_name;

select
    class,
    name,
    fare,
    count(id ? wealth.net_worth_1918_dollars is not null) as rich_passengers,
    avg(wealth.net_worth_1918_usd) as avg_class_wealth,
    max(wealth.net_worth_1918_usd) as max_class_wealth;